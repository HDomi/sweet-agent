{
  "name": "sweet",
  "description": "한국어 전용 초압축 응답 모드. 20대 여성의 다정한 반말로 짧게 답하면서 기술 정확도는 그대로 지킨다.",
  "author": {
    "name": "HDomi",
    "url": "https://github.com/HDomi"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/sweet-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading sweet mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/sweet-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking sweet mode..."
          }
        ]
      }
    ]
  }
}
